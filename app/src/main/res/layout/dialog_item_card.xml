<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_top_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header row: X close + title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnCardClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnCardClose"
            android:layout_marginStart="8dp"
            android:text="Add Item"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Captured / existing photo -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgCardPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Item photo" />
    </androidx.cardview.widget.CardView>

    <!-- Item Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="My Keys"
        android:paddingHorizontal="12dp"
        android:inputType="textCapWords"
        android:singleLine="true" />

    <!-- Location -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="13sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_field">

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/btnLocationVoice"
            android:background="@android:color/transparent"
            android:hint="Above the mini table"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnLocationVoice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_white"
            app:tint="@color/white"
            android:backgroundTint="#1B4965"
            android:padding="8dp"
            android:src="@android:drawable/ic_btn_speak_now" />
    </RelativeLayout>

    <!-- Record Message (optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Message (Optional)"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="13sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input_field">

        <TextView
            android:id="@+id/tvRecordPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btnRecordPlay"
            android:text="Start recording yourself!"
            android:textColor="#999999"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btnRecordEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1B4965"
            android:padding="8dp"
            app:tint="@color/white"
            android:src="@android:drawable/ic_menu_edit" />

        <ImageButton
            android:id="@+id/btnRecordPlay"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_toStartOf="@id/btnRecordEdit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1B4965"
            android:padding="8dp"
            app:tint="@color/white"
            android:src="@android:drawable/ic_media_play" />
    </RelativeLayout>

    <!-- Save -->
    <Button
        android:id="@+id/btnCardSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_button"
        android:backgroundTint="#1B4965"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>